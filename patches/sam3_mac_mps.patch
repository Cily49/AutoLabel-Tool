@@ -6,7 +6,22 @@ import numpy as np
 import torch
 import torch.nn.functional as F
 from numpy.typing import NDArray
-from sam3.model.edt import edt_triton
+try:
+    from sam3.model.edt import edt_triton as _edt_triton_kernel
+except ImportError:  # triton unavailable (e.g. macOS / CPU-only)
+    _edt_triton_kernel = None
+
+
+def edt_triton(data):
+    """EDT with Triton on CUDA, falling back to OpenCV elsewhere (macOS/MPS/CPU)."""
+    if _edt_triton_kernel is not None and data.is_cuda:
+        return _edt_triton_kernel(data)
+    import cv2
+    import numpy as np
+
+    arr = data.detach().to("cpu").numpy().astype(np.uint8)
+    out = np.stack([cv2.distanceTransform(m, cv2.DIST_L2, 0) for m in arr])
+    return torch.from_numpy(out).to(device=data.device, dtype=torch.float32)
 
 
